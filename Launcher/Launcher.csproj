<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <AssemblyName>Steam Desktop Authenticator</AssemblyName>
    <ApplicationIcon>..\Steam Desktop Authenticator\ASDA-icon.ico</ApplicationIcon>
    <DebugType>portable</DebugType>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <Target Name="PublishMainApp" AfterTargets="Publish">
    <Exec Command="dotnet publish &quot;..\Steam Desktop Authenticator\Steam Desktop Authenticator.csproj&quot; -c $(Configuration) -r win-x64 --self-contained false -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=false -p:PublishTrimmed=false -p:EnableCompressionInSingleFile=false -p:DebugSymbols=false -o &quot;$(PublishDir)bin&quot;" />
    
    <!-- Move the Launcher's PDB to the bin folder to keep the root clean -->
    <Move SourceFiles="$(PublishDir)Steam Desktop Authenticator.pdb" DestinationFolder="$(PublishDir)bin" Condition="Exists('$(PublishDir)Steam Desktop Authenticator.pdb')" />
  </Target>

</Project>
